# --- Backend ---
APP_ENV=development
JWT_SECRET=change_me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=geolegalvault
# --- Storage (R2 / S3-compatible; RustFS for local dev) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=geolegalvault-dev
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me
STORAGE_PRESIGN_TTL_SEC=60
MAX_UPLOAD_MB=10
# Cap for every request body other than the document upload (KB).
MAX_JSON_BODY_KB=1024
# --- Blockchain ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/CHANGE_ME
SERVICE_WALLET_PRIVATE_KEY=change_me
CONTRACT_ADDRESS=0xCHANGE_ME
CHAIN_ID=11155111
ANCHOR_CONFIRMATIONS=1
CHAIN_RPC_URL=http://localhost:8545
ANCHOR_MAX_ATTEMPTS=3
ANCHOR_RETRY_BACKOFF_SEC=1.0
ANCHOR_CONFIRM_POLL_ATTEMPTS=5
ANCHOR_CONFIRM_POLL_INTERVAL_SEC=0.3
# --- Anchor retry worker (REL-01; the one optional worker, Guardrail #10) ---
# Transient failures back off min(CAP, BASE*2^(n-1)) seconds for MAX_ATTEMPTS failures, then
# the document is marked permanently failed (RETRIES_EXHAUSTED) and shows in the admin alert.
ANCHOR_RETRY_BASE_SEC=30
ANCHOR_RETRY_CAP_SEC=900
ANCHOR_RETRY_MAX_ATTEMPTS=8
ANCHOR_REVERT_MAX_ATTEMPTS=2
# Out-of-funds wallet: slower schedule, same attempt cap.
ANCHOR_FUNDS_RETRY_BASE_SEC=600
ANCHOR_FUNDS_RETRY_CAP_SEC=3600
# A PENDING tx the node no longer knows, after this long, is declared TX_DROPPED and re-sent.
ANCHOR_PENDING_TIMEOUT_SEC=600
# A worker's claim on a document. Must stay LONGER than ANCHOR_PENDING_TIMEOUT_SEC.
ANCHOR_LEASE_SEC=900
# The worker only auto-sends for documents stuck for less than this many days. Older ones are
# listed as "needs admin retry" and are never auto-sent: with SEPOLIA_RPC_URL pointing at a
# public node, a first worker start must not spend testnet gas on months-old demo rows.
ANCHOR_AUTO_RETRY_MAX_AGE_DAYS=7
ANCHOR_WORKER_INTERVAL_SEC=15
# /health reports anchor_worker=stale (and the compose healthcheck fails) past this heartbeat age.
ANCHOR_WORKER_STALE_SEC=120
# A stuck APPROVED document shows in GET /blockchain/anchors/attention after this long.
ANCHOR_ATTENTION_GRACE_SEC=120
# --- Geofence ---
GEO_ACCURACY_MAX_M=100
GEO_FRESHNESS_MAX_SEC=60
# Optional: minLng,minLat,maxLng,maxLat (GeoJSON order) that every geofence vertex must
# fall inside. Helps catch a swapped [lat, lng] polygon, but only when the swapped
# position lands outside the box - see DECISIONS.md D-027. Empty = not enforced.
GEOFENCE_ALLOWED_BBOX=
# --- Observability ---
SENTRY_DSN=
# --- CORS ---
CORS_ORIGINS=http://localhost:5173
# --- Hardening ---
RATE_LIMIT_PER_MIN=120
